# Brain Sentry — exemplo de .env para docker-compose.production.yml
# Copie para .env e preencha. NUNCA commite o .env preenchido.
# Sugestão: mantenha os valores reais em ~/.env-projetos/brainsentry.env.

# ── Obrigatórios (compose falha sem eles) ────────────────────────────────
POSTGRES_PASSWORD=
# >= 32 chars; gere com: openssl rand -hex 32
JWT_SECRET=
# API key do provider LLM (OpenRouter/Anthropic via openrouter)
BRAINSENTRY_AI_AGENTIC_MODEL_API_KEY=
# Origens reais do frontend, separadas por vírgula — sem localhost
CORS_ORIGINS=https://app.suaempresa.com
# Tag pinada do FalkorDB (não use latest)
FALKORDB_VERSION=v4.2.2

# ── Opcionais ────────────────────────────────────────────────────────────
#POSTGRES_DB=brainsentry
#POSTGRES_USER=brainsentry
#DB_SSLMODE=disable            # require/verify-full com Postgres externo
#BRAINSENTRY_VERSION=local     # tag das imagens ghcr.io
#BRAINSENTRY_AI_MODEL=anthropic/claude-haiku-4-5
#HTTP_PORT=80
#TZ=America/Sao_Paulo
#BACKUP_SCHEDULE=@daily
#BACKUP_KEEP_DAYS=7
#BACKUP_KEEP_WEEKS=4
#BACKUP_KEEP_MONTHS=6
